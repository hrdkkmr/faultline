# Copy to .env and adjust. Never commit .env.

# FalkorDB connection (required)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FAULTLINE_GRAPH=faultline

# Safety limits for graph traversal
FAULTLINE_MAX_DEPTH=6
FAULTLINE_QUERY_TIMEOUT_MS=5000

# Data locations (relative to repo root)
FAULTLINE_DATA_DIR=data

# Logging: DEBUG | INFO | WARNING | ERROR
FAULTLINE_LOG_LEVEL=INFO

# Optional LLM narrator. Leave empty for deterministic-only mode.
# Supported: "" (none) | "anthropic"
FAULTLINE_LLM_PROVIDER=
ANTHROPIC_API_KEY=
FAULTLINE_LLM_MODEL=claude-opus-5-5
FAULTLINE_LLM_TIMEOUT_S=20

# Frontend -> backend URL (used by Vite dev server)
VITE_API_BASE=http://localhost:8000
